  "usage_notes": {
    "matching_strategy": "POI名称先去除行政区前缀（如'北京市'）和stopwords，然后逐词与keywords中的word进行精确匹配（mode=exact）。若POI名称包含多个关键词，取匹配到的最高权重作为该POI的专名强度得分（NameScore）。",
    "score_calculation": "单个POI的最终认知显著性得分 = weight_base（类别基础分） + NameScore，其中NameScore来自匹配到的关键词权重。若未匹配任何关键词，NameScore=0，仅获得类别基础分。",
    "category_aggregation": "对于某一三级类别，其整体知名度基准（即用于替换百度指数的'类别基准热度'） = 该类别下所有POI的NameScore的平均值 × 10（归一化至0-5分制），以便与搜索指数量级对齐。",
    "data_update_frequency": "建议每季度根据官方新发布的地标名单、老字号认定、商业榜单更新一次关键词库，保持时效性。"
  }
